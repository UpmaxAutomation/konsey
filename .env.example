# LLM Council Environment Configuration
# Copy this file to .env and fill in your values

# ======================
# Database Configuration
# ======================
DB_USER=council
DB_PASSWORD=your_secure_database_password
DB_NAME=llm_council

# ======================
# Security Configuration
# ======================
# IMPORTANT: Generate a secure secret key for production!
# You can generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_secret_key_minimum_32_characters_here

# JWT Configuration
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# ======================
# API Keys
# ======================
# OpenRouter API key (required for LLM access)
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here

# Optional: Direct provider API keys (bypass OpenRouter)
# OPENAI_API_KEY=sk-your-openai-key
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
# GOOGLE_API_KEY=your-google-key

# ======================
# Google OAuth (optional)
# ======================
# Get these from https://console.cloud.google.com
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret

# ======================
# URLs and CORS
# ======================
# Your domain (for production)
FRONTEND_URL=https://council.yourdomain.com
CORS_ORIGINS=https://council.yourdomain.com

# For local development:
# FRONTEND_URL=http://localhost:3000
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Vite build-time variables
VITE_API_URL=/api

# ======================
# Port Configuration
# ======================
HTTP_PORT=80

# ======================
# Cloudflare Tunnel (optional)
# ======================
# Get this from Cloudflare Zero Trust dashboard
# CLOUDFLARE_TUNNEL_TOKEN=eyJxxxxxx

# ======================
# Optional Features
# ======================
# Enable debug mode (shows SQL queries)
# DB_ECHO=false

# Email configuration (for verification emails - future feature)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
