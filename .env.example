# LLM Council Environment Configuration
# Copy this file to .env and fill in your values

# ======================
# Database Configuration
# ======================
# Set to "true" to use database instead of JSON file storage
USE_DATABASE=true

# Option 1: Supabase (Recommended for production)
# Get your connection string from: Supabase Dashboard > Project Settings > Database > Connection string
# Use the "Transaction" connection string with port 6543 for serverless, or "Session" with port 5432
DATABASE_URL=postgresql+asyncpg://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Supabase client (optional - for Supabase Auth and Realtime features)
SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Option 2: Local PostgreSQL (for development)
# DATABASE_URL=postgresql+asyncpg://council:your_password@localhost:5432/llm_council

# Legacy individual vars (used by docker-compose)
DB_USER=council
DB_PASSWORD=your_secure_database_password
DB_NAME=llm_council

# ======================
# Security Configuration
# ======================
# IMPORTANT: Generate a secure secret key for production!
# Requirements:
#   - Minimum 32 characters (64+ recommended)
#   - Use cryptographically random characters
#   - Never commit the actual key to version control
#   - Rotate keys periodically (quarterly recommended)
#
# Generate a secure key with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
#
# SECRET ROTATION PROCEDURE:
#   1. Generate a new secret key
#   2. Update the SECRET_KEY in your deployment environment
#   3. Restart the application
#   4. Users will need to log in again (JWT tokens are invalidated)
#   5. Re-encrypt any API keys stored in the database (they use SECRET_KEY for encryption)
#
# WARNING: Changing SECRET_KEY will:
#   - Invalidate all existing JWT tokens (users must re-authenticate)
#   - Break decryption of stored API keys (must be re-entered by users)
#
SECRET_KEY=your_secret_key_minimum_32_characters_here

# Environment (development/staging/production)
# In production, strict security validation is enforced
ENVIRONMENT=development

# JWT Configuration
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# ======================
# API Keys
# ======================
# OpenRouter API key (required for LLM access)
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here

# Optional: Direct provider API keys (bypass OpenRouter)
# OPENAI_API_KEY=sk-your-openai-key
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
# GOOGLE_API_KEY=your-google-key

# ======================
# Google OAuth (optional)
# ======================
# Get these from https://console.cloud.google.com
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret

# ======================
# URLs and CORS
# ======================
# Your domain (for production)
FRONTEND_URL=https://council.yourdomain.com
CORS_ORIGINS=https://council.yourdomain.com

# For local development:
# FRONTEND_URL=http://localhost:3000
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Vite build-time variables
VITE_API_URL=/api

# ======================
# Port Configuration
# ======================
HTTP_PORT=80

# ======================
# Cloudflare Tunnel (optional)
# ======================
# Get this from Cloudflare Zero Trust dashboard
# CLOUDFLARE_TUNNEL_TOKEN=eyJxxxxxx

# ======================
# Optional Features
# ======================
# Enable debug mode (shows SQL queries)
# DB_ECHO=false

# Email configuration (for verification emails - future feature)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
